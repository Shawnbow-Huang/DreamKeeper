<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 源集存在：只为本机假服务器放行明文 HTTP。

  放行范围严格限定在两个域：127.0.0.1（adb reverse 后的本机端口）与 10.0.2.2
  （模拟器访问宿主机的别名）。base-config 故意不写任何放行属性，走 targetSdk 37
  的默认「禁止明文」；这样即便以后有人把这个文件挪进 main，默认值也仍是禁止。
-->
<network-security-config>
    <base-config />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
